{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "description": "https://nullvoxpopuli.com",
  "repository": "https://github.com/NullVoxPopuli/website/",
  "license": "MIT",
  "author": "NullVoxPopuli",
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#config": "./app/config.ts",
    "#components/*": "./app/components/*",
    "#services/*": "./app/services/*",
    "#test-helpers/*": "./tests/helpers/*",
    "#utils/*": "./app/utils/*",
    "#site": "./site.mjs"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "vite",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "build:test": "EMBER_ENV=test NODE_ENV=development vite build --mode development",
    "test:ci": "testem ci --port 0",
    "test": "pnpm build:test && pnpm test:ci",
    "lint:types": "tsc --noEmit --runExternalCode",
    "test:output": "pnpm build && node --test tests/output/*.test.mjs"
  },
  "dependencies": {
    "@embroider/macros": "^1.21.4",
    "@embroider/router": "^3.0.6",
    "@glimmer/component": "^2.2.1",
    "@responsive-image/core": "^2.1.1",
    "@responsive-image/ember": "^3.1.1",
    "decorator-transforms": "^2.4.0",
    "ember-page-title": "^9.0.3",
    "ember-source": "~7.3.0",
    "reactiveweb": "^1.9.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@babel/runtime": "^7.29.10",
    "@ember/app-tsconfig": "^2.1.0",
    "@ember/test-helpers": "^5.7.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/core": "^4.6.10",
    "@glint/ember-tsc": "^1.14.3",
    "@glint/template": "^1.11.1",
    "@nullvoxpopuli/ember-vite": "1.4.0",
    "@nullvoxpopuli/eslint-configs": "^7.1.0",
    "@responsive-image/vite-plugin": "^3.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@shikijs/rehype": "^4.5.0",
    "@types/qunit": "^2.19.14",
    "@typescript/native": "npm:typescript@^7.1.0-dev.20261101.1",
    "babel-plugin-debug-macros": "^2.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "concurrently": "^9.2.5",
    "ember-content-mapper": "^0.4.0",
    "ember-qunit": "^9.2.0",
    "eslint": "^10.14.0",
    "feed": "^6.0.0",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.26.0",
    "qunit-dom": "3.6.0",
    "qunit-theme-ember": "^1.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "testem": "3.21.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "vite": "^8.3.5",
    "vite-ember-ssr": "^0.6.2"
  },
  "engines": {
    "node": ">= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "packageManager": "pnpm@10.34.7"
}
